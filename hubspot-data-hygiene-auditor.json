    {
      "parameters": {
        "jsCode": "// Build one summary row for this audit run.\nconst items = $input.all();\nconst total = items.length;\nconst flagged = items.filter(i => i.json.issuesText !== 'No issues found').length;\nconst critical = items.filter(i => i.json.score < 60).length;\nconst avg = total ? Math.round(items.reduce((s, i) => s + i.json.score, 0) / total) : 0;\n\nreturn [{\n  json: {\n    date: new Date().toISOString().slice(0, 10),\n    totalRecords: total,\n    flagged,\n    critical,\n    averageScore: avg\n  }\n}];"
      },
