    {
      "parameters": {
        "jsCode": "// Score every contact for data hygiene issues.\nconst items = $input.all();\nconst out = [];\n\nfunction emailValid(e) {\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(e || '');\n}\n\nfor (const item of items) {\n  const p = item.json.properties || {};\n  const email = (p.email && p.email.value) || '';\n  const phone = (p.phone && p.phone.value) || '';\n  const stage = (p.lifecyclestage && p.lifecyclestage.value) || '';\n  const firstname = (p.firstname && p.firstname.value) || '';\n  const lastname = (p.lastname && p.lastname.value) || '';\n\n  const issues = [];\n  if (!email || !emailValid(email)) issues.push('Missing/invalid email');\n  if (!phone) issues.push('Missing phone');\n  if (!stage) issues.push('Missing lifecycle stage');\n\n  const score = Math.round(100 - (issues.length * (100 / 3)));\n  const name = [firstname, lastname].filter(Boolean).join(' ') || '(no name)';\n\n  out.push({\n    json: {\n      id: item.json.vid,\n      email,\n      name,\n      recordType: 'contact',\n      score,\n      issuesText: issues.length ? issues.join('; ') : 'No issues found'\n    }\n  });\n}\n\nreturn out;"
      },
      "id": "c71bb7db-278a-4590-85d0-34e59841eb5c",
      "name": "Score Contacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Score every company for data hygiene issues.\nconst items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const p = item.json.properties || {};\n  const domain = (p.domain && p.domain.value) || '';\n  const industry = (p.industry && p.industry.value) || '';\n  const phone = (p.phone && p.phone.value) || '';\n  const name = (p.name && p.name.value) || '(no name)';\n\n  const issues = [];\n  if (!domain) issues.push('Missing domain');\n  if (!industry) issues.push('Missing industry');\n  if (!phone) issues.push('Missing phone');\n\n  const score = Math.round(100 - (issues.length * (100 / 3)));\n\n  out.push({\n    json: {\n      id: item.json.companyId,\n      domain,\n      name,\n      recordType: 'company',\n      score,\n      issuesText: issues.length ? issues.join('; ') : 'No issues found'\n    }\n  });\n}\n\nreturn out;"
      },
